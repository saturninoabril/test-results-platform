# Example environment configuration for Test Results API
# Copy this file to .env and update values for your environment

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=info
APP_NAME="Test Results API"
APP_VERSION=0.4.0

# Database Settings
DATABASE_URL=postgresql+asyncpg://test_results_user:test_results_password@localhost:5433/test_results
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Storage Settings (MinIO for development)
STORAGE_TYPE=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PREFIX=dev
STORAGE_USE_SSL=false
STORAGE_MAX_FILE_SIZE=104857600  # 100MB
STORAGE_SIGNED_URL_EXPIRY=3600   # 1 hour

# Storage Settings (AWS S3 for production)
# STORAGE_TYPE=s3
# STORAGE_ACCESS_KEY=your-aws-access-key
# STORAGE_SECRET_KEY=your-aws-secret-key
# STORAGE_REGION=us-west-2
# STORAGE_BUCKET_PREFIX=prod
# STORAGE_USE_SSL=true

# Authentication Settings
AUTH_JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_EXPIRATION_HOURS=24

# GitHub OAuth Settings (required for user authentication)
AUTH_GITHUB_CLIENT_ID=your-github-oauth-client-id
AUTH_GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
AUTH_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Automation Token Settings
AUTH_AUTOMATION_TOKEN_EXPIRY_DAYS=90

# API Settings
APP_API_PREFIX=/api/v1
APP_DOCS_URL=/docs
APP_REDOC_URL=/redoc
APP_MAX_REQUESTS_PER_SECOND=1000
APP_REQUEST_TIMEOUT=30

# CORS Settings
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:3001"]
APP_CORS_ALLOW_CREDENTIALS=true

# Redis Settings (optional, for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Mattermost Webhook Settings (optional, for notifications)
MATTERMOST_ENABLED=false
MATTERMOST_WEBHOOK_URL=https://your-mattermost.domain.com/hooks/your-webhook-token
MATTERMOST_USERNAME=Test Results Bot
MATTERMOST_CHANNEL=#test-results
MATTERMOST_ICON_URL=https://example.com/bot-icon.png
MATTERMOST_NOTIFY_TEST_FAILURES=true
MATTERMOST_NOTIFY_SUITE_COMPLETION=true
MATTERMOST_NOTIFY_HIGH_FAILURE_RATE=true
MATTERMOST_FAILURE_RATE_THRESHOLD=0.3

# Development/Testing Settings
# Override for test environment
# DATABASE_URL=postgresql+asyncpg://test_results_user:test_results_password@localhost:5433/test_results_test
# STORAGE_BUCKET_PREFIX=test
# APP_ENV=test